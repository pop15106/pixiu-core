/vault/memory/*
!/vault/memory/memory-summary.md
!/vault/memory/SESSION-INDEX.md
!/vault/memory/agent-learning/
!/vault/memory/agent-learning/**

# 本機產生的私人設定與安裝狀態，不納入版本控制
.github/copilot-instructions.md
fleet.json
.agent/ecc-install-state.json
scripts/hooks/debug-input.json
.claude/settings.local.json
/vault/context/hermes-host-home.txt

# Windows 保留名稱的意外產物不納入版本控制
/NUL

# Hook debug payload 與 vault 備份可能包含敏感內容，不得提交
vault_backup_*/

# 身分資料屬私人內容，不納入版本控制
vault/identity/

# Pixiu 執行報告與 audit logs 可能包含本機或郵件資訊
.agent/pixiu/reports/

# Hook runtime、thread-watcher 與 recap review 暫存狀態
/state/
/recap-review-*

# Governance 自動備份
/vault/governance/backups/

# 通用備份檔
*.bak
*.bak-*

# DevSpace portable 發佈產物由 build-portable-package.ps1 產生，不納入版本控制
/scripts/devspace-portable/dist/

# Session Workflow portable 發佈產物由 build-portable.ps1 產生，不納入版本控制
/artifacts/session-workflow-portable/
